# ============================================================
# Ermay ERP — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# --- General ---
NODE_ENV=development

# --- Database (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=erp_user
DB_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
DB_DATABASE=ermay_erp
DB_SSL_ENABLED=false
DB_POOL_SIZE=50

# --- JWT ---
# CRITICAL: Generate a strong random secret for production!
# Run: openssl rand -base64 64
JWT_SECRET=CHANGE_THIS_RUN_openssl_rand_base64_64
JWT_EXPIRES_IN=8h

# --- App ---
APP_PORT=5143

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- RabbitMQ (FAZ 2+) ---
# RABBITMQ_URL=amqp://erp_user:password@localhost:5672

# --- Storage (FAZ 2+) ---
# STORAGE_PROVIDER=local
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# --- Observability (FAZ 3+) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# LOG_LEVEL=info

# --- DB Logging ---
DB_LOGGING_ENABLED=true

# --- MySQL Root (Docker Compose only) ---
MYSQL_ROOT_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD

# --- ErmayWeb entegrasyonu ---
# İki projede aynı değer: ErmayWeb/.env → ERP_INTEGRATION_KEY. Üret: openssl rand -hex 32
# Boşsa /api/integration uçları 503 döner.
INTEGRATION_KEY=
# ERP'nin satış onayını bildireceği ErmayWeb backend adresi
ERMAY_WEB_URL=http://172.17.0.1:5000
