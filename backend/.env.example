# Environment
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=erp_user
DB_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
DB_DATABASE=ermaye_production

# JWT Config
# CRITICAL: Generate a strong random secret for production!
# Run: openssl rand -base64 64
JWT_SECRET=CHANGE_THIS_RUN_openssl_rand_-base64_64
JWT_EXPIRES_IN=8h

# App
APP_PORT=5143
